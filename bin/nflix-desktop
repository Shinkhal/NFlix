#!/bin/sh
set -eu
BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP_DIR=$(CDPATH= cd -- "$BIN_DIR/../lib/nflix-desktop" && pwd)
unset ELECTRON_RUN_AS_NODE
if [ -x "$APP_DIR/electron/nflix-desktop" ]; then
    "$APP_DIR/electron/nflix-desktop" "$@" &
    child=$!
    trap 'kill "$child" 2>/dev/null || true' INT TERM
    status=0
    wait "$child" || status=$?
    if [ "$status" -eq 3 ] && [ "${1:-}" = --check-playback ]; then
        exec "$APP_DIR/electron/nflix-desktop" "$@"
    fi
    exit "$status"
fi
echo "Nflix Desktop runtime is missing. Reinstall the application." >&2
exit 1
